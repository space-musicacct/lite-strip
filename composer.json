{
    "name": "space-musicacct/lite-strip",
    "description": "Lightweight AI-optimized HTML extraction tool powered by ReactPHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-sockets": "*",
        "react/http": "^1.10",
        "react/async": "^4.3",
        "react/promise": "^3.2",
        "react/dns": "^1.13",
        "react/socket": "^1.16",
        "league/html-to-markdown": "^5.1",
        "chrome-php/chrome": "^1.15",
        "react/child-process": "^0.6.7",
        "ext-pcntl": "*"
    },
    "autoload": {
        "psr-4": {
            "LiteStrip\\": "src/"
        }
    },
    "scripts": {
        "start": "php server.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    }
}
